# ============ 运行环境 ============
NODE_ENV=production
PORT=3000
# ⚠️ 容器内必须 0.0.0.0：docker-proxy 从 bridge 网段转发进来，
#    绑 127.0.0.1 会表现为 "Connection reset by peer"。
#    对外暴露由 compose 的 ports: 127.0.0.1:3000:3000 锁定，不会上公网。
HOST=0.0.0.0
LOG_LEVEL=info

# ============ 数据库 ============
# 容器内用服务名 db；宿主机端口映射到 5433 以避开宝塔 MySQL 的 3306
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
DATABASE_URL=postgres://couple:CHANGE_ME_DB_PASSWORD@db:5432/couple

# ============ 令牌 ============
# 生成：openssl rand -hex 32
JWT_SECRET=CHANGE_ME_64_HEX_CHARS
JWT_ISSUER=couple-menu
ACCESS_TTL_SEC=900
REFRESH_TTL_DAYS=30

# ============ 超管 ============
ADMIN_PHONE=18756459919
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_NICKNAME=管理员

# ============ 文件 ============
MEDIA_ROOT=/data/images
MEDIA_BASE_PATH=/media
# 留空则返回相对路径；填域名则返回绝对 URL（客户端离线缓存更省心）
MEDIA_BASE_URL=
MAX_UPLOAD_MB=5

# ============ 备份 ============
BACKUP_DIR=/data/backup
BACKUP_KEEP=3
